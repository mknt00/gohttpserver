#!/bin/bash
#

# push manifest
if [[ ! -d $HOME/.docker ]]
then
    mkdir $HOME/.docker
fi

set -ex

if test $(uname) = "Linux"
then
	sed -i '/experimental/d' $HOME/.docker/config.json
	sed -i '1a"experimental": "enabled",' $HOME/.docker/config.json
fi

docker manifest create mknt00/gohttpserver \
  mknt00/gohttpserver:latest \
  mknt00/gohttpserver:armhf
docker manifest annotate mknt00/gohttpserver \
  mknt00/gohttpserver:latest --os linux --arch amd64
docker manifest annotate mknt00/gohttpserver \
  mknt00/gohttpserver:armhf --os linux --arch arm --variant v7
docker manifest push mknt00/gohttpserver

# check again
docker run mplatform/mquery mknt00/gohttpserver
